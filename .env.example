# Frontend: public API origin. Safe to expose in the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Launcher custom ports belong in your shell, not in .pokerlab.env:
# export POKERLAB_WEB_PORT=13000 POKERLAB_API_PORT=18000
# ./pokerlab
# 启动器自定义端口请在终端导出，不要写入 .pokerlab.env。
# Changing the API port requires rebuilding the web image (no --no-build).
# 修改 API 端口后需重新构建 Web 镜像（不要使用 --no-build）。
# Manual Compose: align NEXT_PUBLIC_API_URL and CORS_ORIGINS with your ports.
# 手动使用 Compose 时，请同步设置 API 地址和跨域来源。

# ./pokerlab creates the ignored .pokerlab.env file and a random database
# password automatically. Set these only when invoking Compose manually.
# ./pokerlab 会自动创建已忽略的 .pokerlab.env 和随机数据库密码；仅在手动
# 调用 Compose 时设置以下变量。
POSTGRES_DB=pokerlab
POSTGRES_USER=pokerlab
POSTGRES_PASSWORD=replace-with-a-random-local-value

# API persistence. Defaults to local SQLite when omitted.
DATABASE_URL=sqlite:///./pokerlab.db

# Comma-separated browser origins allowed by the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Safety limits for public endpoints.
POKERLAB_MAX_MONTE_CARLO=500000
POKERLAB_MAX_SOLVER_ITERATIONS=5000
POKERLAB_MAX_CONCURRENT_SOLVERS=2
